#: C:\Users\tamas\Studio\plugin23456\wp-content\plugins\refitune\admin\page-help.php
msgid ""
"Adds early <code>&lt;link rel=\"preload\"&gt;</code> hints to the document "
"<code>&lt;head&gt;</code> so the browser can fetch critical CSS, fonts, scripts, or "
"images sooner. Output is wrapped in HTML comments (<code>&lt;!-- RefiTune-Preload --&gt;"
"</code>) for easier source inspection.<br><br><strong>Rows:</strong> each entry has a "
"URL, a location (everywhere, front page via <code>is_front_page()</code>, blog page via "
"<code>is_home()</code>, or a specific post ID), and attributes from the HTML / MDN "
"preload model: <code>as</code>, optional <code>type</code> (MIME), "
"<code>crossorigin</code>, and <code>fetchpriority</code>. Use <strong>Add preload</"
"strong> for a blank row, or remove a row with the trash icon.<br><br><strong>Add Font-"
"Library fonts:</strong> on click, reads active fonts from the WordPress Font Library "
"(files under the fonts directory that are enabled in Global Styles) and appends them to "
"the list. "
"Defaults per imported row: location everywhere, <code>as=font</code>, <code>type</code> "
"from the file extension (<code>font/woff2</code> or <code>font/woff</code>), "
"<code>crossorigin=anonymous</code>, <code>fetchpriority=auto</code>. URLs already in "
"the list are skipped; empty rows are filled first.<br><br><strong>URLs:</strong> only "
"same-site URLs are accepted - the value must start with your site URL "
"(<code>home_url</code> or <code>site_url</code>). One URL per row. Invalid URLs show an "
"inline error after blur and disable Save until fixed.<br><br><strong>Font and fetch:</"
"strong> MDN requires a matching <code>crossorigin</code> mode for font and fetch "
"preloads (typically <code>anonymous</code>), otherwise the preload may not be reused."
"<br><br><strong>Note:</strong> Preload does not replace a proper cache or CDN strategy. "
"Only preload assets the page will use soon; over-preloading wastes bandwidth."
msgstr ""



#: C:\Users\tamas\Studio\plugin23456\wp-content\plugins\refitune\admin\admin-core.php:70
#: C:\Users\tamas\Studio\plugin23456\wp-content\plugins\refitune\admin\page-help.php:43
msgid "Disable jQuery Migrate"
msgstr "A jQuery Migrate letiltása"

#: C:\Users\tamas\Studio\plugin23456\wp-content\plugins\refitune\admin\admin-core.php:71
msgid "Removes the jquery-migrate script from frontend pages."
msgstr "Eltávolítja a jquery-migrate szkriptet a frontend oldalakról."

#: C:\Users\tamas\Studio\plugin23456\wp-content\plugins\refitune\admin\admin-core.php:75
#: C:\Users\tamas\Studio\plugin23456\wp-content\plugins\refitune\admin\page-help.php:49
msgid "Disable oEmbed"
msgstr "Az oEmbed letiltása"

#: C:\Users\tamas\Studio\plugin23456\wp-content\plugins\refitune\admin\admin-core.php:76
msgid ""
"Disables automatic embedding of external content (YouTube, Vimeo, Twitter, etc.) from pasted "
"URLs."
